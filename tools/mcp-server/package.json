{
  "name": "sixbutton-mcp-server",
  "version": "0.1.0",
  "description": "Local stdio MCP server that drives a live SixButtonUI app over a UART bridge (SIXBUTTONUI_ENABLE_MCP wire protocol).",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sixbutton-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@serialport/parser-readline": "^12.0.0",
    "serialport": "^12.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^20.14.0"
  },
  "allowScripts": {
    "@serialport/bindings-cpp@12.0.1": true
  }
}
